# Local overrides (copy to .env.local)
NEXT_PUBLIC_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# -----------------------------------------------------------------------------
# Vercel preview / production (branch: vercel)
# Frontend: https://belajar-frontend-website-v2.vercel.app
# Backend / DB: Hostinger Laravel at https://api.evomi.shop
# Set these in Vercel Project → Settings → Environment Variables
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_URL=https://api.evomi.shop
# NEXT_PUBLIC_API_URL=https://api.evomi.shop/api
# NEXT_PUBLIC_SITE_URL=https://belajar-frontend-website-v2.vercel.app

# Hostinger frontend (branch: main only — do not point Hostinger deploy at "vercel")
# NEXT_PUBLIC_URL=https://api.evomi.shop
# NEXT_PUBLIC_API_URL=https://api.evomi.shop/api
